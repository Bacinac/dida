# DIDA configuration — copy to .env and edit
# Paths set in .env are bind-mounted into containers via docker-compose.
#
# NOTE: this file is the SEED, not the source. Per-adapter config (brokers, device
# hosts, credentials, poll intervals) lives in the DB, edited under Settings →
# Adapters. So do the values that describe this installation — its LAN address, its
# public address, the NIC the VLANs hang off, which adapters run: the DB wins and
# Settings → Network / Adapters is where they are changed. What genuinely has to
# live here is what must be known BEFORE the DB can be read (Postgres/ClickHouse/
# NATS credentials, DIDA_SECRET_KEY, state paths) and what compose itself reads
# before any process exists (ports, device nodes, profiles).

# =========================================================================
# Storage paths (host)
# =========================================================================
# DIDA has ONE tier — there is no large media stream like BABA. Everything
# (postgres data, NATS jetstream, clickhouse data) is small and hot, so place it
# on the fast pool with the rest of /mnt/docker. Service logs go to stdout
# (captured by Docker's json-file driver, capped per container) — no logs volume.
# Empty = install.sh fills it with <clone>/state, so the stack stores its data
# wherever you cloned it rather than at a path baked into this template.
DIDA_STATE_HOST=
# Where scheduled backups land — kept out of the state dir so a backup is never
# next to the data it backs up. Empty = <clone>/backups. Point at an NFS/off-box
# mount for real durability.
DIDA_BACKUP_HOST=
# This clone's path as the HOST knows it. The runner (Settings → Adapters, the
# switches) drives compose from inside a container, and compose derives every bind
# mount's host path from the project directory — so it must be mounted at the same
# absolute path it has outside. Empty = install.sh fills it with this clone.
DIDA_REPO_HOST=

# =========================================================================
# Adapter profiles — ONE PER ADAPTER, so an installation runs processes for the
# hardware it actually has and its Settings → Adapters list is that hardware.
# Core (nats/postgres/clickhouse/mosquitto/engine/api/automation/ui/runner/virtual/
# astro/netmgr/lanprobe/notify/announce) is untagged and ALWAYS runs. Empty (the
# default below) = core only; add what you have — or switch it on in Settings →
# Adapters, which is the runner writing this same line. Device adapters:
#   androidtv · baba · broadlink · calendar · cast · denon · dlna · ecowitt ·
#   esphome · frigate · govee · harmony · heos · homekit · iammeter · landroid ·
#   matter · midea · mqtt · opus · presence · shelly · smartthings ·
#   solar · tuya · volumio
# Plus three that bring their own service rather than an adapter:
#   · zigbee — the zigbee2mqtt bridge for a local coordinator (needs
#     DIDA_ZIGBEE_DEVICE); pair with `mqtt`, which is what reads it into DIDA.
#   · esphome-dashboard (http://<host>:6052) — the build toolchain that compiles
#     and OTA-flashes this installation's own nodes, into state/esphome/. Nothing
#     at runtime needs it: the `esphome` adapter talks to finished nodes over
#     their API. Turn it on while flashing, off after.
#   · cloudflare — this installation's Cloudflare tunnel (two connectors) plus
#     the adapter that edits its ingress routes from the UI. Enable once the
#     tunnel's credentials.json + cert.pem are in state/cloudflared.
# =========================================================================
COMPOSE_PROFILES=

# =========================================================================
# Postgres — system of record (registry, current_state, automations, auth)
# =========================================================================
# The superuser: only postgres and the keys service see it. Services log in as
# their own roles, with passwords derived from DIDA_SECRET_KEY (dida_core.db_roles).
POSTGRES_USER=dida
# generiraj: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=dida
# Host-published loopback port (the host-networked lanprobe reaches PG here).
DIDA_PG_HOST_PORT=5442

# =========================================================================
# ClickHouse — append-only history / event firehose (live: engine batches to it)
# =========================================================================
CLICKHOUSE_DB=dida
CLICKHOUSE_USER=dida
# generiraj: openssl rand -hex 24
CLICKHOUSE_PASSWORD=

# =========================================================================
# API
# =========================================================================
# Distinct from BABA's 8080 so both stacks can co-exist on one host.
DIDA_API_PORT=8090
# Comma-separated CORS allowlist. Empty falls back to dev SvelteKit origins.
DIDA_CORS_ORIGINS=
# SEED ONLY (like every value below that describes this installation): the api
# copies it into app_settings at first boot and never reads it again — after that
# Settings → Network is the only place it changes, and editing this line does
# nothing. Set it to the externally-reachable origin (the Cloudflare tunnel).
DIDA_PUBLIC_URL=http://[::1]:5273
DIDA_APP_URL=http://localhost:5273

# =========================================================================
# UI (SvelteKit). LAN-exposed host port; the browser reaches the API through
# the UI's /api proxy. Distinct from BABA's 5173.
# =========================================================================
DIDA_UI_PORT=5273
# Empty = the real vite build served by ui/server.js. Set to `dev` only on a
# machine you develop on: that swaps in the Vite dev server with HMR and a
# bind-mounted source tree, which costs ~230 MB more RAM and serves unbuilt code.
DIDA_UI_TARGET=

# =========================================================================
# Auth (argon2 + JWT cookie)
# =========================================================================
# Shared secret: JWT signing AND cross-service Fernet (api encrypts adapter
# secrets and the OPUS token; adapters decrypt with the SAME value).
# MUST be set — leaving it empty makes the api mint a per-instance JWT key while
# adapters get nothing, so every adapter secret silently fails to
# decrypt. Generate once with `openssl rand -hex 32` and keep it identical across
# all containers; changing it invalidates stored secrets + open sessions.
DIDA_SECRET_KEY=
# The session cookie is Secure automatically on HTTPS requests (the Cloudflare
# tunnel — detected via X-Forwarded-Proto) and non-Secure on plain-HTTP LAN, so
# leave this false; set true only to force Secure on every response.
DIDA_COOKIE_SECURE=false
# Optional: enable the Prometheus /metrics endpoint. Unset → /metrics returns 404
# (disabled, so it can't leak operational data behind the tunnel). Set a token to
# scrape it: `curl -H "Authorization: Bearer <token>" .../api/metrics`. The System
# page's /system/stats is always available to a signed-in user, no token needed.
DIDA_METRICS_TOKEN=
# Optional: comma-separated IPs of trusted reverse proxies whose X-Forwarded-For
# the login rate-limiter should honour. Empty = trust internal (private/loopback)
# hops, which covers the vite /api proxy and cloudflared in this deployment.
#DIDA_TRUSTED_PROXIES=
# First-run admin bootstrap. If password is empty, a random one is generated
# and written to state/api/bootstrap_admin_password (read once, then delete).
DIDA_ADMIN_USERNAME=admin
DIDA_ADMIN_PASSWORD=

# =========================================================================
# Assistant (Claude) — natural-language control / queries / automation authoring
# =========================================================================
# Your Anthropic API key. Empty → the /assistant endpoint returns 503 and the
# "Asistent" tab shows a not-configured notice; the rest of DIDA is unaffected.
ANTHROPIC_API_KEY=

# THIS host's address on the LAN the AV devices are on. MANDATORY — compose refuses
# to start without it. The AV adapters (dlna/denon/heos) bind SSDP to it (see core
# local_ip()) — on a multi-homed host the default route is NOT necessarily the LAN
# (prod routes over the IoT VLAN), and SSDP on the wrong leg discovers nothing while
# the adapter still reports healthy. Seed only: Settings → Network owns it after
# first boot. For example 198.51.100.100.
DIDA_LAN_IP=
# OPUS · Player — where the house's music and radio come from. The address as the
# devices in the house reach it (they fetch the bytes from it directly) and the
# household's service token (Library → Settings → token). Seed only; empty = the
# media page has no shelf until Settings → Network says otherwise.
DIDA_OPUS_URL=
DIDA_OPUS_TOKEN=

# =========================================================================
# Matter bridge — exposes DIDA entities to Google Home / Alexa / Apple Home
# (profile: matter). Host-networked.
# =========================================================================
DIDA_MATTER_PORT=5540
# Pin Matter/mDNS to the LAN NIC (host networking exposes every Docker veth).
DIDA_MATTER_INTERFACE=ens18
# Activity pickers (CSV of source/source_options entity ids, e.g. harmony:hub):
# every source option becomes its own voiceable Matter plug ("turn on PS5" →
# set_source PS5; turning the active one off → the power-off option).
DIDA_MATTER_ACTIVITY_ENTITIES=

# =========================================================================
# Network — netmgr (IoT-VLAN ingress) + lanprobe (LAN self-discovery)
# =========================================================================
# Parent host NIC the macvlan VLAN sub-interfaces attach to.
DIDA_NET_PARENT=ens18
# Group owning /var/run/docker.sock; install.sh and upgrade.sh set it from the host.
DIDA_DOCKER_GID=

# =========================================================================
# Local MQTT broker credentials. The mosquitto user that every co-located
# bridge (zigbee2mqtt, zwave-js, govee2mqtt) authenticates with. Leave the
# password EMPTY here (fail-loud, like POSTGRES/CLICKHOUSE) and set a real one
# in your .env — then generate the matching broker credential from THIS value
# (./install.sh does this for you; to do it by hand):
#   docker run --rm eclipse-mosquitto:2 sh -c \
#     'mosquitto_passwd -b -c /tmp/p "$1" "$2" >/dev/null && cat /tmp/p' \
#     _ "$DIDA_MQTT_USERNAME" "$DIDA_MQTT_PASSWORD" > docker/mosquitto.passwd
# docker/mosquitto.passwd is gitignored (never commit the hash). The govee adapter
# reads these directly from the co-located broker; no separate copy in the DB.
# =========================================================================
DIDA_MQTT_USERNAME=dida
DIDA_MQTT_PASSWORD=

# =========================================================================
# zigbee2mqtt bridge (compose profile: zigbee). Brought up only once the
# coordinator is free of any other owner (ZHA, another z2m). The frontend is
# published on this port; coordinator settings live in
# state/zigbee2mqtt/configuration.yaml.
#
# A NETWORK coordinator needs nothing here — leave DIDA_ZIGBEE_DEVICE empty and
# point serial.port at tcp://<host>:<port>. A USB stick is named by its host
# path and appears in the container as /dev/zigbee. Use the by-id path, not
# /dev/ttyUSBn: the latter is assigned in enumeration order and moves the day a
# second serial device shows up.
#   DIDA_ZIGBEE_DEVICE=/dev/serial/by-id/usb-ITead_Sonoff_Zigbee_3.0_USB_Dongle_Plus_<serial>-if00-port0
# On an LXC host, pass it into the container first (PVE 8.2+):
#   pct set <ctid> -dev0 <that same path>,uid=0,gid=20,mode=0660
# =========================================================================
DIDA_Z2M_PORT=8092
DIDA_ZIGBEE_DEVICE=

# =========================================================================
# Govee (compose profile: home). Wez Furlong's govee2mqtt bridge runs as a
# sibling container and republishes Govee devices as HA MQTT Discovery onto
# our mosquitto, where the co-located `govee` adapter ingests them. Account credentials
# (email/password[/API key]) are NOT set here — enter them in Settings →
# Adapters → Govee; the `govee` adapter writes them to the bridge and restarts
# it. Broker creds come from DIDA_MQTT_* above.
# =========================================================================

# Astro (sun elevation + time of day): the home location comes from the home zone
# (Zones → the one flagged Home) — the single source of truth for "here" — and
# altitude/tz/cadence are set in Settings → Adapters. Nothing to configure here.

# Address of the sister BABA NVR, if you run one. Empty hides the
# "open in BABA" link on the Cameras page.
#DIDA_BABA_URL=https://baba.example.com

# Log verbosity for every DIDA service (DEBUG|INFO|WARNING|ERROR|CRITICAL).
# Per-container override: set it on one service in docker-compose.override.yml to
# raise just that adapter without touching the rest.
DIDA_LOG_LEVEL=INFO
